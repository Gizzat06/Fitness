        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Пайдаланушы {\n    +int id\n    +String аты\n    +String телефон\n    +String email\n    +String құпияСөз\n    +String рөл\n    +тіркелу()\n    +кіру()\n    +рөлТаңдау()\n}\n\nclass Абонемент {\n    +int id\n    +String түрі\n    +Date басталуКүні\n    +Date аяқталуКүні\n    +String күйі\n    +тексеру()\n}\n\nclass ВиртуалдыКезек {\n    +int id\n    +DateTime уақыт\n    +int кезекНөмірі\n    +String күйі\n    +кезеккеТұру()\n    +кезектенШығу()\n}\n\nclass Тренажер {\n    +int id\n    +String атауы\n    +String түрі\n    +String күйі\n    +күйінТексеру()\n}\n\nclass АқауӨтінімі {\n    +int id\n    +String сипаттама\n    +DateTime құрылғанУақыт\n    +String күйі\n    +өтінімЖасау()\n    +күйінӨзгерту()\n}\n\nПайдаланушы \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Абонемент : иеленеді\nПайдаланушы \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ВиртуалдыКезек : кезекке тұрады\nПайдаланушы \&quot;1\&quot; --&gt; \&quot;0..*\&quot; АқауӨтінімі : хабарлайды\n\nВиртуалдыКезек \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Тренажер : қатысты\nАқауӨтінімі \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Тренажер : қатысты&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3CsD6mQCJCjR5TAoeeSV-1">
